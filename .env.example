# =====================================================================
# LexVault — environment configuration
# Copy this file to `.env` and fill in your Supabase project values.
# The portal runs fully offline without these (demo OTP channel and
# on-screen person codes) — adding them switches on real email delivery.
# =====================================================================

# Supabase project URL — dashboard → Project Settings → API
VITE_SUPABASE_URL=

# Supabase ANON / public key (safe to expose — RLS protects your data).
# NEVER put the service_role key in a frontend build.
VITE_SUPABASE_ANON_KEY=

# =====================================================================
# ONE-TIME CODES (factor 2)
# Supabase Auth emails the 6-digit code directly. To make emails leave
# Supabase: dashboard → Authentication → Emails → SMTP Settings, and
# configure your provider (Resend, SES, SendGrid, …).
#
# PERSON CODE EMAILS (after registration)
# Deploy the bundled Edge Function once:
#   supabase functions deploy send-person-code
# then set its provider secret, e.g.:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
# =====================================================================
